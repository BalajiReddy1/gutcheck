# ---- Client (safe to expose; these are Firebase Web config, not secrets) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server only ----
# On Cloud Run this is injected from Secret Manager. Locally, paste an AI Studio key.
GEMINI_API_KEY=

# Firebase Admin: on Cloud Run, Application Default Credentials are used automatically
# and only the project id is needed. Locally, run `gcloud auth application-default
# login` (preferred, no key material on disk), or set FIREBASE_SERVICE_ACCOUNT_JSON
# to the whole service-account JSON on one line.
FIREBASE_PROJECT_ID=your-project
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
