# Committed on purpose, and baked into the container at build time.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`, which
# runs inside the Dockerfile. Passing them at deploy time with --set-env-vars is
# too late, so they have to live here.
#
# These four are Firebase web config. They are public by design and already
# visible in the shipped JavaScript; your Firestore rules are what actually
# protects the data. NEVER add GEMINI_API_KEY or a service account to this file:
# it is committed to git and copied into the image. Those come from Secret
# Manager at runtime instead.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBXwi0gdWZ_PkScknpycF_ygGJryXG67ZI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gutcheck-95114.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gutcheck-95114
NEXT_PUBLIC_FIREBASE_APP_ID=1:422182188221:web:fcad51d508b16c4fbc73d4

# Deployed origin. Drives canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://gutcheck-422182188221.asia-south1.run.app
